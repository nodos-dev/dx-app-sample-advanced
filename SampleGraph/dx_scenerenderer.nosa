                "usage": "TRANSFER_SRC TRANSFER_DST SAMPLED STORAGE RENDER_TARGET"
              },
              "advanced_property": true,
              "meta_data_map": [
                { "key": "AdvancedProperty", "value": "true" }
              ],
              "contents_type": "JobPin",
              "contents": { },
              "description": "Source image coming from Video/Cinema camera\nAlways try to provide a high resolution image with minimal processing.\nAvoid sharpening (detail) filters in camera and/or color clamping caused by colorspace conversion matrix."
            },
            {
              "id": "9646eda5-68fb-4f2d-a7f1-97dd81ec6c21",
              "name": "Clean_Plate",
              "type_name": "nos.sys.vulkan.Texture",
              "show_as": "INPUT_PIN",
              "can_show_as": "INPUT_PIN_ONLY",
              "visualizer": {
              },
              "data": {
                "resolution": "HD",
                "width": 1920,
                "height": 1080,
                "format": "R16G16B16A16_SFLOAT",
                "usage": "TRANSFER_SRC TRANSFER_DST SAMPLED STORAGE RENDER_TARGET"
              },
              "def": {
                "resolution": "HD",
                "width": 1920,
                "height": 1080,
                "format": "R16G16B16A16_SFLOAT",
                "usage": "TRANSFER_SRC TRANSFER_DST SAMPLED STORAGE RENDER_TARGET"
              },
              "advanced_property": true,
              "meta_data_map": [
                { "key": "AdvancedProperty", "value": "true" }
              ],
              "contents_type": "JobPin",
              "contents": { },
              "description": "Provide a clean plate image to be used by Color Differencing algorithms.\nUsually provided from a Cyclorama node, rendered with Clean Plate(s) for a moving Camera\nor from a Still Image file for a static Camera production."
            },
            {
              "id": "1c354f1d-6290-4be0-b809-7bf8ed2ffca9",
              "name": "Clean_Plate_Mask",
              "type_name": "nos.sys.vulkan.Texture",
              "show_as": "INPUT_PIN",
              "can_show_as": "INPUT_PIN_ONLY",
              "visualizer": {
              },
              "data": {
                "resolution": "HD",
                "width": 1920,
                "height": 1080,
                "format": "R16G16B16A16_SFLOAT",
                "usage": "TRANSFER_SRC TRANSFER_DST SAMPLED STORAGE RENDER_TARGET"
              },
              "def": {
                "resolution": "HD",
                "width": 1920,
                "height": 1080,
                "format": "R16G16B16A16_SFLOAT",
                "usage": "TRANSFER_SRC TRANSFER_DST SAMPLED STORAGE RENDER_TARGET"
              },
              "advanced_property": true,
              "meta_data_map": [
                { "key": "AdvancedProperty", "value": "true" }
              ],
              "contents_type": "JobPin",
              "contents": { },
              "description": "Mask texture accepts 3 seperate masks used by the Reality Keyer in R,G,B channels\nR->Garbage Mask: 0.0=Force Alpha to be transparent; 1.0=Use Alpha output from the Keyer\nG->Force Fill: 0.0=Use Alpha out from the Keyer; 1.0=Force Alpha to be opaque\nB->Spill Bypass: 0.0=Despill the image with algorithms; 1.0=Force the fill image to have its original color values, bypassing despill algorithms"
            },
