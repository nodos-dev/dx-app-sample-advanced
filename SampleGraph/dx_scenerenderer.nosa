          "pos": { "x": 202.0, "y": 591.0 },
          "contents_type": "Job",
          "contents": { "type": "" },
          "function_category": "Default Node",
          "description": "Creates an Image-Based Key using Color Differencing algorithms using CleanPlate input.\nReality Keyer can also generate a core matte and combine it with soft mattes.\nIt also has green screen subtraction and despilling algorithms for the fill image.\nReality Keyer also accepts a mask texture to be used as Garbage, Force-Fill and Spill-Bypass masks.",
          "plugin_version": { "major": 1, "minor": 8, "patch": 1 }
        },
